# Use production on a public host. Production refuses weak/default admin tokens.
APP_ENV=development

# Required before a public deployment (minimum 24 characters in production)
ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional: the app works in deterministic demo mode without an API key.
# Use the client's own key in production; never put it in browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

DATABASE_PATH=runtime/leaddesk.db
BUSINESS_FILE=data/business.json
KNOWLEDGE_FILE=data/knowledge_base.json
STORE_CONVERSATIONS=true
RATE_LIMIT_PER_MINUTE=20

# Optional HTTPS endpoint for Zapier, Make, n8n, Slack, or a CRM.
LEAD_WEBHOOK_URL=

# Comma-separated exact origins only if you call the API outside the iframe widget.
CORS_ORIGINS=

# Hosting platforms such as Railway inject this automatically.
PORT=8000

